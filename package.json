{
  "name": "roster-pro",
  "version": "0.0.1",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.8",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "fix": "turbo fix",
    "clean": "turbo run clean",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "dev:marketing": "turbo run dev --filter=marketing",
    "dev:client-web": "turbo run dev --filter=client-web",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=api",
    "build:marketing": "turbo run build --filter=marketing",
    "build:client-web": "turbo run build --filter=client-web",
    "db:generate": "turbo run db:generate --filter=api",
    "db:push": "turbo run db:push --filter=api",
    "db:migrate": "turbo run db:migrate --filter=api",
    "db:studio": "turbo run db:studio --filter=api"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
